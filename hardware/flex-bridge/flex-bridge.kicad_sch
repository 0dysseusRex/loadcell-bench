	(text "Full bridge on one face of the binocular flexure." (exclude_from_sim no) (at 25.4 55 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "acdfe9aa-b25f-48b4-9f20-c547338a0c10"))
	(text "Adjacent necks see opposite bending strain. Diagonally opposite necks see the same sign," (exclude_from_sim no) (at 25.4 51.19 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b73e18bd-4562-43da-a5c6-6c8c204fdaa9"))
	(text "so tension and compression sit on opposite arms." (exclude_from_sim no) (at 25.4 47.379999999999995 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "bf6ae92a-fb69-4b8e-9805-1dd56dff88d5"))
	(text "R1 upper left is tension, from E+ to S-." (exclude_from_sim no) (at 25.4 43.56999999999999 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "da7d7c41-cebf-4a57-bc35-190f45d02969"))
	(text "R2 upper right is compression, from E+ to S+." (exclude_from_sim no) (at 25.4 39.75999999999999 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "dc6611f5-75cf-49e0-a4be-c6f9b1851d6e"))
	(text "R3 lower left is compression, from S- to E-." (exclude_from_sim no) (at 25.4 35.94999999999999 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "57ec104c-f151-43f3-958b-0b24dc5fca62"))
	(text "R4 lower right is tension, from S+ to E-." (exclude_from_sim no) (at 25.4 32.139999999999986 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ef34519b-d38b-4b4a-98f1-363532e3ee83"))
	(text "E+ and E- are excitation. S+ and S- are signal." (exclude_from_sim no) (at 25.4 28.329999999999988 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b41fde21-cee9-40c5-8530-7ced3a434b02"))
	(text "G1-G8 are the flex pads solder-blobbed to the gauge tabs. J1-J4 are the wiring pads." (exclude_from_sim no) (at 25.4 24.51999999999999 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0b0d2c3a-d048-4d89-bc14-c329b13d5e7d"))
