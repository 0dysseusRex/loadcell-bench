		(legacy_teardrops no)
	)
	(paper "A4")
	(title_block
		(title "flex-bridge")
		(comment 1 "Binocular flexure, four gauges on one face. Adjacent necks see opposite strain.")
		(comment 2 "Tension R1 upper-left and R4 lower-right, opposite arms. Compression R2 upper-right and R3 lower-left.")
		(comment 3 "Single-sided polyimide. 1 copper layer, 0.5 oz (18 um). 50 um core. Coverlay open on the 8 gauge pads and 4 wiring pads. 0.2 mm polyimide stiffener under the wire pads and under all eight gauge pads on Eco1.User.")
		(comment 4 "Board outline is the two outer sides and the bottom bar. No copper across the top.")
	)
	(layers
		(0 "F.Cu" signal "top_layer")
		(2 "B.Cu" signal "bottom_layer")
		(9 "F.Adhes" user "F.Adhesive")
		(13 "F.Paste" user)
		(5 "F.SilkS" user "F.Silkscreen")
		(1 "F.Mask" user)
		(17 "Dwgs.User" user "User.Drawings")
		(19 "Cmts.User" user "User.Comments")
		(21 "Eco1.User" user "User.Eco1")
		(23 "Eco2.User" user "User.Eco2")
